#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.13,<3.15"
# dependencies = [
#   "psycopg[binary]==3.3.9",
#   "onnxruntime==1.32.0",
#   "tokenizers==0.23.3",
#   "huggingface-hub==2.4.0",
#   "numpy==2.5.5",
#   "pyyaml==6.0.3",
# ]
